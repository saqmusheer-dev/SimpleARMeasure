<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <com.saqmusheer.simplearmeasure.MeasurementOverlayView
        android:id="@+id/measurementOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simple AR Measure"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="#B8000000"
                android:maxWidth="360dp"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:text="Move the camera to detect the floor."
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#CC111111"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="@android:color/white"
            android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:background="#99000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCALE"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.saqmusheer.simplearmeasure.RulerView
            android:id="@+id/rulerView"
            android:layout_width="66dp"
            android:layout_height="220dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="FLOOR MODE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/floorButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Floor"
            android:textSize="11sp" />

        <Button
            android:id="@+id/kitchenTopButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Kitchen Top"
            android:textSize="9sp" />

        <Button
            android:id="@+id/heightButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Person Height"
            android:textSize="9sp" />

        <Button
            android:id="@+id/areaButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Area"
            android:textSize="11sp" />

        <Button
            android:id="@+id/directButton"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="3D"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="84dp">

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DD000000"
            android:gravity="center"
            android:minWidth="180dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="—"
            android:textColor="@android:color/white"
            android:textSize="27sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/finishAreaButton"
            android:layout_width="120dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="FINISH"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="120dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="RESET"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>