<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <com.saqmusheer.simplearmeasure.MeasurementOverlayView
        android:id="@+id/measurementOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARmeasure"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#B0000000"
                android:maxWidth="330dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text="Ready"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/projectsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#CC111111"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▣"
            android:textColor="@android:color/white"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="6dp"
        android:background="#66000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCALE"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold" />

        <com.saqmusheer.simplearmeasure.RulerView
            android:id="@+id/rulerView"
            android:layout_width="50dp"
            android:layout_height="180dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="FLOOR"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ENGINEER / CONSTRUCTION -->
    <LinearLayout
        android:id="@+id/engineerMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="126dp"
        android:background="#E9151520"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="ENGINEER / CONSTRUCTION"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/floorButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Floor" android:textSize="10sp" />
            <Button android:id="@+id/areaButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Auto Area" android:textSize="10sp" />
            <Button android:id="@+id/customAreaButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Custom Area" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/directButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Wall / 3D" android:textSize="10sp" />
            <Button android:id="@+id/heightButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Person Height" android:textSize="9sp" />
            <Button android:id="@+id/scanEngineerButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Scan" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- INTERIOR DESIGN -->
    <LinearLayout
        android:id="@+id/interiorMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="126dp"
        android:background="#E9151520"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="INTERIOR DESIGN" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/roomDesignButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Room Design" android:textSize="10sp" />
            <Button android:id="@+id/furnitureButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Furniture" android:textSize="10sp" />
            <Button android:id="@+id/wallDesignButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Wall Design" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- KITCHEN -->
    <LinearLayout
        android:id="@+id/kitchenMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="126dp"
        android:background="#E9151520"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="KITCHEN" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/kitchenTopButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Kitchen Top" android:textSize="10sp" />
            <Button android:id="@+id/kitchenLShapeButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="L-Shape" android:textSize="10sp" />
            <Button android:id="@+id/kitchenUShapeButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="U-Shape" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- OBJECTS -->
    <LinearLayout
        android:id="@+id/objectMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="126dp"
        android:background="#E9151520"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="OBJECT SCAN" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/objectScanButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Scan Object" android:textSize="10sp" />
            <Button android:id="@+id/doorObjectButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Door" android:textSize="10sp" />
            <Button android:id="@+id/windowObjectButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Window" android:textSize="10sp" />
            <Button android:id="@+id/furnitureObjectButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Furniture" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- RESULT / EDIT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="72dp">

        <Button
            android:id="@+id/scanNowButton"
            android:layout_width="190dp"
            android:layout_height="48dp"
            android:text="SCAN NOW"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/segmentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DD000000"
            android:gravity="center"
            android:minWidth="180dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@android:color/white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/editMenuButton"
            android:layout_width="82dp"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:text="✎ EDIT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/areaTools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/penButton" android:layout_width="64dp" android:layout_height="38dp" android:minWidth="0dp" android:text="PEN" android:textSize="9sp" />
            <Button android:id="@+id/eraserButton" android:layout_width="70dp" android:layout_height="38dp" android:minWidth="0dp" android:text="ERASE" android:textSize="9sp" />
            <Button android:id="@+id/undoAreaButton" android:layout_width="64dp" android:layout_height="38dp" android:minWidth="0dp" android:text="UNDO" android:textSize="9sp" />
            <Button android:id="@+id/doneAreaButton" android:layout_width="64dp" android:layout_height="38dp" android:minWidth="0dp" android:text="DONE" android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/finishAreaButton"
            android:layout_width="96dp"
            android:layout_height="38dp"
            android:text="FINISH"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="5dp"
            android:background="#E6111118"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button android:id="@+id/engineerButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="#332B2B3A" android:minWidth="0dp" android:text="▣&#10;ENGINEER" android:textSize="9sp" />
            <Button android:id="@+id/interiorButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="#332B2B3A" android:minWidth="0dp" android:text="⌂&#10;INTERIOR" android:textSize="9sp" />
            <Button android:id="@+id/kitchenButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="#332B2B3A" android:minWidth="0dp" android:text="▤&#10;KITCHEN" android:textSize="9sp" />
            <Button android:id="@+id/objectsButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="#332B2B3A" android:minWidth="0dp" android:text="◉&#10;OBJECTS" android:textSize="9sp" />
            <Button android:id="@+id/settingsBottomButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:backgroundTint="#332B2B3A" android:minWidth="0dp" android:text="⚙&#10;SETTINGS" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button android:id="@+id/saveButton" android:layout_width="86dp" android:layout_height="36dp" android:minWidth="0dp" android:text="SAVE" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/resetButton" android:layout_width="86dp" android:layout_height="36dp" android:layout_marginStart="5dp" android:minWidth="0dp" android:text="RESET" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>